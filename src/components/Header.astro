---
import Button from "./Button.astro";

const links = [
  { href: "/", label: "Home" },
  { href: "/contact/", label: "Contact" },
];

const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<header class="sticky top-0 z-10 border-b-2 border-border bg-main">
  <div class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-4 sm:px-6">
    <a href="/" class="shrink-0">
      <img src="/leonard-grazian.png" alt="Leonard Grazian" width="278" height="36" class="h-8 w-auto sm:h-9" />
    </a>
    <nav class="flex gap-3" aria-label="Main">
      {
        links.map(({ href, label }) => (
          <Button
            href={href}
            size="sm"
            variant={isActive(href) ? "noShadow" : "neutral"}
            aria-current={isActive(href) ? "page" : undefined}
          >
            {label}
          </Button>
        ))
      }
    </nav>
  </div>
</header>
