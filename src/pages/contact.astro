---
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import Button from "../components/Button.astro";
---

<Base title="Contact" description="Get in touch with Leonard Grazian.">
  <Card class="items-start gap-6 p-8 sm:p-10">
    <p class="text-4xl font-heading sm:text-6xl">DM me on X!</p>
    <p class="text-lg">You can follow me too 🙏</p>
    <Button href="https://x.com/leonard_cvai" size="lg" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      @leonard_cvai
    </Button>
  </Card>
</Base>
